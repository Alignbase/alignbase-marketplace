{
  "description": "Load Alignbase context and report Claude Code activity through authenticated lifecycle hooks.",
  "hooks": {
    "SessionStart": [{
      "matcher": "startup|resume|clear|compact|fork",
      "hooks": [
        {"type":"mcp_tool","server":"plugin:alignbase:alignbase","tool":"start_hook_session","input":{"integration":"claude","adapter_version":"1.1.0","capabilities":["context_session_start","context_prompt_retry","prompt_submit","final_response","subagent_lifecycle"],"session_id":"${session_id}","delivery_point":"session_start"},"timeout":30,"statusMessage":"Loading Alignbase context"},
        {"type":"command","command":"node \"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.mjs\"","timeout":10}
      ]
    }],
    "UserPromptSubmit": [{"hooks":[
      {"type":"mcp_tool","server":"plugin:alignbase:alignbase","tool":"start_hook_session","input":{"integration":"claude","adapter_version":"1.1.0","capabilities":["context_session_start","context_prompt_retry","prompt_submit","final_response","subagent_lifecycle"],"session_id":"${session_id}","delivery_point":"user_prompt_submit"},"timeout":30,"statusMessage":"Loading Alignbase context"},
      {"type":"mcp_tool","server":"plugin:alignbase:alignbase","tool":"record_hook_activity_event","input":{"integration":"claude","adapter_version":"1.1.0","capabilities":["context_session_start","context_prompt_retry","prompt_submit","final_response","subagent_lifecycle"],"event":{"schema_version":"1","event_type":"prompt.submitted","session_id":"${session_id}","source":"user_prompt_submit","completeness":"complete","prompt_text":"${prompt}"}},"timeout":30,"statusMessage":"Recording Alignbase activity"}
    ]}],
    "Stop": [{"hooks":[
      {"type":"mcp_tool","server":"plugin:alignbase:alignbase","tool":"record_hook_activity_event","input":{"integration":"claude","adapter_version":"1.1.0","capabilities":["context_session_start","context_prompt_retry","prompt_submit","final_response","subagent_lifecycle"],"event":{"schema_version":"1","event_type":"response.final","session_id":"${session_id}","source":"stop","completeness":"complete","response_text":"${last_assistant_message}"}},"timeout":30,"statusMessage":"Recording Alignbase activity"}
    ]}],
    "SubagentStart": [{"hooks":[
      {"type":"mcp_tool","server":"plugin:alignbase:alignbase","tool":"record_hook_activity_event","input":{"integration":"claude","adapter_version":"1.1.0","capabilities":["context_session_start","context_prompt_retry","prompt_submit","final_response","subagent_lifecycle"],"event":{"schema_version":"1","event_type":"subagent.started","session_id":"${session_id}","actor_id":"${agent_id}","actor_type":"${agent_type}","parent_session_id":"${session_id}","source":"subagent_start","completeness":"complete"}},"timeout":30,"statusMessage":"Recording Alignbase subagent"}
    ]}],
    "SubagentStop": [{"hooks":[
      {"type":"mcp_tool","server":"plugin:alignbase:alignbase","tool":"record_hook_activity_event","input":{"integration":"claude","adapter_version":"1.1.0","capabilities":["context_session_start","context_prompt_retry","prompt_submit","final_response","subagent_lifecycle"],"event":{"schema_version":"1","event_type":"response.final","session_id":"${session_id}","actor_id":"${agent_id}","actor_type":"${agent_type}","parent_session_id":"${session_id}","source":"subagent_stop","completeness":"complete","response_text":"${last_assistant_message}"}},"timeout":30,"statusMessage":"Recording Alignbase subagent"}
    ]}]
  }
}
